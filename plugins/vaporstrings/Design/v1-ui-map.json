    { "target": "fx", "note": "FX detail panel is tabbed: tab chips (view fx-*) switch which page of controls is visible. Default page = fx-haze. Hidden pages are real DOM elements toggled via a data-view class; they occupy the same cells x18.5-42, y29-39." },
    { "target": "fx-scope", "note": "fx-scope canvas is shared by all FX pages and draws the active effect: pitch arrow (SLOW), transfer curve (DRIVE), 3 phase-offset LFO traces (ENSEMBLE), wobbling tape line (WOBBLE), decay tail with freeze glow (HAZE), repeat taps (ECHO), LFO waveforms (MOD)." },
    { "target": "tab chips", "note": "Each tab chip shows a small LED dot reflecting its *_on param (MOD tab lit when either LFO amount != 0)." },
    { "target": "horizon", "note": "Header horizon: pink→orange striped sun, perspective cyan grid scrolling toward viewer; output waveform drawn as glowing mountain silhouette on the horizon line (30 fps, pauses when hidden)." },
    { "target": "tracking", "note": "Tracking display: big detected note (m_note) + cents needle, confidence bar (m_conf); turns --warn with 'CHORD? MONO SYNTH' when confidence low while gate open." },
    { "target": "vapor", "note": "Hero knob: chrome ring with pink→cyan conic neon arc, glow intensity follows value." },
    { "target": "io-meters", "note": "Two horizontal bars IN / OUT (m_in, m_out), cyan→pink→warn gradient, peak hold." },
    { "target": "env-curve", "note": "Envelope view: draws ADSR / follow / swell shape for env_mode; live m_env dot riding the curve." },
